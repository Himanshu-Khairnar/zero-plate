NEXT_PUBLIC_API_URL= https://wasteless-ml.onrender.com
# Python ML service (server-side calls from route handlers)
ML_SERVICE_URL= https://wasteless-ml.onrender.com

# Shared PostgreSQL database (Neon in dev/prod); the ML service reads the same DB.
# Local zero-setup option: `npm run db:local` starts a PGlite Postgres on 5433.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres
AUTH_SECRET=QUj4ZWCok5FmlloxgFg/JY6bnDPToyDEmM2ejt8nNmI=

# Module B: shared key a POS uses to push sales to POST /api/pos/sales
POS_API_KEY=change-me
# Module L: optional; without it the assistant runs in rule-based mode
#ANTHROPIC_API_KEY=
# Module K: optional email delivery for alerts
#RESEND_API_KEY=
#ALERT_EMAIL_FROM=alerts@example.com
#ALERT_EMAIL_TO=owner@example.com
# Prisma pool size (keep 1 for the local PGlite server; 5-10 for Neon)
DB_POOL_MAX=1
