CORS_ORIGINS=["http://localhost:3000"]
# Shared PostgreSQL database (same as frontend DATABASE_URL, with the psycopg driver prefix).
# Local dev: PGlite server from `npm run db:local` in frontend/. Neon: postgresql+psycopg://user:pass@host/db?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5433/postgres
USE_OPEN_METEO=true
HOLIDAY_COUNTRY=IN
