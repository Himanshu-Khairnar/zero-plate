CORS_ORIGINS=["http://localhost:3000"]
# Same database Prisma uses. Defaults to ../frontend/prisma/dev.db (SQLite).
# Postgres example: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/wasteless
#DATABASE_URL=
# Set to false to skip Open-Meteo and use climatology (offline/CI).
USE_OPEN_METEO=true
HOLIDAY_COUNTRY=IN
