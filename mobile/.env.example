# Base URL of the WasteLess Next.js server (the one serving /api/mobile/*).
#
# - Expo web / iOS simulator on the same PC: http://localhost:3100
# - Android emulator:                        http://10.0.2.2:3100
# - Physical phone with Expo Go:             use your PC's LAN IP, e.g. http://192.168.1.23:3100
#   (find it with `ipconfig` -> "IPv4 Address"; phone and PC must be on the same Wi-Fi,
#    and Windows Firewall must allow inbound connections on port 3100).
#
# Copy this file to `.env` (or `.env.local`) and restart `npx expo start` after changing it.
EXPO_PUBLIC_API_URL=http://localhost:3100
